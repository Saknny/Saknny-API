<mjml>
  <mj-head>
    <mj-style>
      .button-link {
        background-color: #003D25;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        padding: 12px 24px;
        display: inline-block;
        font-weight: bold;
      }
    </mj-style>
  </mj-head>

  <mj-body>
    <mj-wrapper background-color="#003D25" border-radius="20px" padding="0">

      <!-- Body -->
      <mj-section background-color="#ffffff" border-radius="0px" padding="10px 0">
        <mj-column width="94%">
          <mj-text font-size="23px" font-weight="530" line-height="25px" color="#003D25">
            Reset Your Password
          </mj-text>
        </mj-column>

        <mj-column width="94%" padding="0 0 10px 0">
          {{#if data.firstName}}
            <mj-text font-weight="350">Dear {{data.firstName}},</mj-text>
          {{else}}
            <mj-text font-weight="350">Hello,</mj-text>
          {{/if}}
        </mj-column>

        <mj-column width="94%">
          <mj-text font-size="15px" padding="0 0 10px 0">
            We received a request to reset your Saknnu account password. If you made this request, click the button below to set a new password:
          </mj-text>

          <mj-button background-color="#003D25" color="#ffffff" border-radius="6px" font-size="16px" href="{{data.resetLink}}">
            Reset Password
          </mj-button>

          <mj-text font-size="13px" padding="20px 0 0 0" color="#888888">
            If you didn’t request a password reset, you can safely ignore this email.<br/>
            The reset link is valid for 30 minutes.
          </mj-text>
        </mj-column>

        <mj-column padding="10px 0 10px 0">
          <mj-text>
            Best regards,
            <br/><br/>
            <b>The Saknny Team</b>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Footer -->
      <mj-section background-color="#f4f4f4" padding="20px">
        <mj-column>
          <mj-text font-size="12px" color="#777" align="center">
            © 2025 Saknny. All rights reserved.
            <br/>
            Need help? Contact us at <a href="mailto:support@Saknny.com" style="color:#003D25;">support@Saknny.com</a>
            <br/>
            Saknny, Egypt
          </mj-text>
        </mj-column>
      </mj-section>

    </mj-wrapper>
  </mj-body>
</mjml>
